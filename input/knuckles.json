{
  "controller_type": "knuckles",
  "name": "VR QR Scanner - Valve Index",
  "description": "Reads finger tracking and the right trigger to cancel scans.",
  "bindings": {
    "/actions/camera": {
      "skeleton": [
        {"output": "/actions/camera/in/left", "path": "/user/hand/left/input/skeleton/left"},
        {"output": "/actions/camera/in/right", "path": "/user/hand/right/input/skeleton/right"}
      ],
      "sources": [
        {
          "path": "/user/hand/right/input/trigger",
          "mode": "trigger",
          "inputs": {
            "pull": {"output": "/actions/camera/in/mode_trigger"}
          }
        }
      ]
    }
  }
}
